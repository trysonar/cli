  "homepage": "https://trysonar.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trysonar/cli.git"
  },
  "bugs": {
    "url": "https://github.com/trysonar/cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
