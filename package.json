{
  "name": "sonar-aso",
  "version": "0.1.0",
  "description": "CLI for App Store Optimization — keyword research, rank tracking, and competitor analysis for iOS and Android",
  "type": "module",
  "bin": {
    "sonar": "dist/index.js",
    "aso": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "aso",
